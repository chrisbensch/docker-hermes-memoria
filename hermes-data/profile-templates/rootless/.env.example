# Copy this file to .env inside the profile directory if this profile needs
# profile-local provider keys or tool settings.
#
# The Hindsight bank is selected by config.yaml, not this env file.
HINDSIGHT_BANK_ID=__BANK_ID__

# Shared Obsidian-compatible vault mounted inside Hermes.
OBSIDIAN_VAULT_PATH=__OBSIDIAN_VAULT_PATH__

# Optional profile-local provider placeholders.
# DEEPSEEK_API_KEY=
# LM_BASE_URL=http://host.docker.internal:1234/v1
# LM_API_KEY=

# Optional Telegram bot for this profile. Use a unique token for each profile.
# Set TELEGRAM_ALLOWED_USERS for the people permitted to use this bot.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USERS=

# Web access backends for Hermes on the Compose bridge network.
FIRECRAWL_API_URL=http://firecrawl-api:3002
CAMOFOX_URL=http://camofox:9377
