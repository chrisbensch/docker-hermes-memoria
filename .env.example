# Copy this file to .env and edit it before running docker compose.
#
# On the Ubuntu host, set these to the account that should own files under
# ./appdata. Usually:
#   HERMES_UID=$(id -u)
#   HERMES_GID=$(id -g)
HERMES_UID=1000
HERMES_GID=1000
HERMES_HOME_MODE=0755

# Hermes Agent image.
HERMES_IMAGE=nousresearch/hermes-agent@sha256:d4da4a40cd7a28aba983775d9fd31d94cbf153eeb0cb9e844d6d0f612b7c24db
HERMES_API_BIND_HOST=127.0.0.1
HERMES_API_HOST_PORT=8642
HERMES_DASHBOARD_BIND_HOST=127.0.0.1
HERMES_DASHBOARD_HOST_PORT=9119

# For rootless Docker, set this to the deployment user's Docker socket.
# Usually:
#   DOCKER_SOCK=/run/user/$(id -u)/docker.sock
DOCKER_SOCK=/run/user/1000/docker.sock

# Portable app data directory. Hermes runtime state and each stateful sidecar
# store data under this directory instead of Docker-managed named volumes.
APPDATA_DIR=./appdata

# Optional shared GBrain service. This must be a reviewed, full 40-character
# commit SHA, not a branch or tag. The service starts only with the `gbrain`
# Compose profile. The committed default is the review point used by this repo.
GBRAIN_REF=31f257a0a7b218b40e03d302bc6913c99f26f0ec
GBRAIN_POSTGRES_IMAGE=pgvector/pgvector:pg16

# Optional dashboard/API exposure. Keep loopback-only by default; set the bind
# host to this machine's trusted LAN address only when you need /admin.
GBRAIN_HTTP_BIND_HOST=127.0.0.1
GBRAIN_HTTP_HOST_PORT=3131

# Postgres is reachable only by GBrain over an internal-only network. Generate
# both files with URI-safe random values (for example, `openssl rand -hex 32`),
# chmod them 0600, and never commit them. The admin token must be stable so an
# authorized operator can manage separate OAuth clients for each profile.
GBRAIN_POSTGRES_PASSWORD_FILE=./appdata/gbrain/secrets/postgres-password.txt
GBRAIN_ADMIN_TOKEN_FILE=./appdata/gbrain/secrets/admin-token.txt

# GBrain HTTP and its Hermes-facing MCP broker are reachable only on the
# application network; neither publishes a host port. This owner-only (0700)
# directory holds one owner-only (0600) <profile>.env per Hermes profile. Each
# file contains that profile's unique broker token and OAuth client. Never
# commit the directory or its contents.
GBRAIN_PROFILE_CREDENTIALS_DIR=./appdata/gbrain/secrets/profiles

# Self-hosted-first embedding setup. Run `./setup.sh --gbrain`; it validates a
# real embedding and exact vector width before initializing Postgres. Leave the
# endpoint and model blank in the public template. The key may be empty for an
# unauthenticated local service. Use `--no-embedding` for keyless,
# keyword-only initialization when no embedding server is available.
GBRAIN_EMBEDDING_BASE_URL=
GBRAIN_EMBEDDING_MODEL=
GBRAIN_EMBEDDING_DIMENSIONS=1024
# Put the private provider key here in your ignored .env. Guided setup copies
# it into the mounted 0600 file; leave blank for a keyless local endpoint.
GBRAIN_EMBEDDING_API_KEY=
GBRAIN_EMBEDDING_API_KEY_FILE=./appdata/gbrain/secrets/embedding-api-key.txt

# Optional self-hosted reasoning gateway. GBrain uses its generic LiteLLM
# adapter independently of embeddings. Keep public defaults blank; a local-only
# route such as `litellm:auto/offline` is configured per deployment. The API
# key stays in the ignored file rather than Compose environment values.
GBRAIN_LITELLM_BASE_URL=
GBRAIN_LITELLM_API_KEY_FILE=./appdata/gbrain/secrets/litellm-api-key.txt
GBRAIN_CHAT_MODEL=
GBRAIN_EXPANSION_MODEL=
GBRAIN_MODEL_DISCOVERY=off

# Optional Metabase analytics for GBrain. Run `./setup.sh --gbrain-metabase`
# after GBrain initialization. The public default is loopback-only; bind to a
# trusted LAN address only when other machines need the UI. Both database
# passwords are generated as private files. The encryption key is generated
# directly into the ignored .env and must remain stable across restores.
METABASE_IMAGE=metabase/metabase:v0.58.34@sha256:abd7e4d9162e4dff67d5958d29e55b1e79de8029c51fddfdc12d9903ad126873
METABASE_BIND_HOST=127.0.0.1
METABASE_HOST_PORT=3000
METABASE_APP_DB_PASSWORD_FILE=./appdata/gbrain/secrets/metabase-app-db-password.txt
METABASE_READER_PASSWORD_FILE=./appdata/gbrain/secrets/metabase-reader-password.txt
METABASE_ENCRYPTION_SECRET_KEY=

# Hindsight MCP sidecar.
# The official Hindsight image exposes HTTP MCP at /mcp/ on API port 8888.
HINDSIGHT_IMAGE=ghcr.io/vectorize-io/hindsight:0.9.1
HINDSIGHT_API_BIND_HOST=127.0.0.1
HINDSIGHT_API_HOST_PORT=8888
HINDSIGHT_UI_BIND_HOST=127.0.0.1
HINDSIGHT_UI_HOST_PORT=9999
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_MODEL=gpt-4o-mini
HINDSIGHT_API_LLM_API_KEY=
HINDSIGHT_API_LLM_BASE_URL=
HINDSIGHT_API_LOG_LEVEL=info
HINDSIGHT_API_WORKER_ID=hindsight-mcp

# Local LM Studio example for Hindsight running in Docker. Start LM Studio's
# local server on the host, then use host.docker.internal from the container:
# HINDSIGHT_API_LLM_PROVIDER=lmstudio
# HINDSIGHT_API_LLM_MODEL=your-local-model
# HINDSIGHT_API_LLM_BASE_URL=http://host.docker.internal:1234/v1
# HINDSIGHT_API_LLM_API_KEY=
#
# DeepSeek example for Hindsight:
# HINDSIGHT_API_LLM_PROVIDER=deepseek
# HINDSIGHT_API_LLM_MODEL=deepseek-chat
# HINDSIGHT_API_LLM_API_KEY=sk-your-deepseek-key

# Headroom proxy plus Docker-backed stdio MCP server.
HEADROOM_IMAGE=ghcr.io/headroomlabs-ai/headroom:0.36.5
HEADROOM_PROXY_BIND_HOST=127.0.0.1
HEADROOM_PROXY_HOST_PORT=8787
HEADROOM_TELEMETRY=off

# Optional: set when you want the Headroom proxy to forward to an upstream
# OpenAI-compatible endpoint.
# Example for LM Studio on the Docker host:
# OPENAI_TARGET_API_URL=http://host.docker.internal:1234/v1
OPENAI_TARGET_API_URL=

# Integrated web access stack: Firecrawl + SearXNG + Camofox.
# setup.sh clones Firecrawl source into FIRECRAWL_SOURCE_DIR so the patched
# nuq-postgres image can be built locally.
FIRECRAWL_IMAGE=ghcr.io/firecrawl/firecrawl:latest
FIRECRAWL_PLAYWRIGHT_IMAGE=ghcr.io/firecrawl/playwright-service:latest
FIRECRAWL_SOURCE_DIR=./.firecrawl-src
FIRECRAWL_BIND_HOST=127.0.0.1
FIRECRAWL_HOST_PORT=3002
FIRECRAWL_USE_DB_AUTHENTICATION=false
FIRECRAWL_POSTGRES_USER=postgres
FIRECRAWL_POSTGRES_PASSWORD=
FIRECRAWL_POSTGRES_DB=postgres
FIRECRAWL_BULL_AUTH_KEY=

SEARXNG_IMAGE=searxng/searxng:latest
SEARXNG_NGINX_IMAGE=nginx:alpine
SEARXNG_SETTINGS_FILE=./web-search/searxng-settings.yml
SEARXNG_BIND_HOST=127.0.0.1
SEARXNG_HOST_PORT=8889

CAMOFOX_IMAGE=ghcr.io/jo-inc/camofox-browser:latest
CAMOFOX_BIND_HOST=127.0.0.1
CAMOFOX_HOST_PORT=9377
